# Copy to backend/.env and fill in.

# Cloudflare R2 (song storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lyra-music-storage
R2_CUSTOM_DOMAIN=

# Cloudflare D1 (accounts). CF_ACCOUNT_ID defaults to R2_ACCOUNT_ID.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# Google sign-in (OAuth 2.0 Web client ID)
GOOGLE_CLIENT_ID=

# Signs session cookies; generate with: python -c "import secrets; print(secrets.token_hex(32))"
LYRA_SESSION_SECRET=
